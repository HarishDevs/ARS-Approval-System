{
  "name": "ars-approval-system",
  "version": "1.53.0",
  "private": true,
  "description": "ARS Approval Platform — multi-level approvals in any custom manner",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "node scripts/database/migrate.js && node scripts/database/seed.js && next start",
    "start:production": "npm start",
    "start:app": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "node scripts/database/migrate.js",
    "db:seed": "node scripts/database/seed.js",
    "db:check": "node scripts/database/check-privileges.js",
    "db:verify-backup": "node scripts/database/verify-backup.js"
  },
  "dependencies": {
    "firebase": "11.1.0",
    "firebase-admin": "14.5.0",
    "lottie-web": "5.12.2",
    "lucide-react": "0.469.0",
    "mysql2": "3.24.3",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "typescript": "5.7.3",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    },
    "postcss-selector-parser": "7.1.6",
    "google-gax": {
      "rimraf": {
        "glob": "14.0.3"
      }
    }
  }
}
