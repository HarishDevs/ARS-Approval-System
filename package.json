{
  "name": "ars-approval-system",
  "version": "0.1.0",
  "private": true,
  "description": "ARS Approval Platform — multi-level approvals in any custom manner",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "node scripts/database/migrate.js",
    "db:seed": "node scripts/database/seed.js"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "11.1.0",
    "firebase-admin": "14.3.0",
    "lucide-react": "0.469.0",
    "mysql2": "3.24.3",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "typescript": "5.7.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "vitest": "2.1.9"
  }
}
