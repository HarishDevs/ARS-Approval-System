# ARS Approval Platform — environment template. Never commit a real .env / .env.local.
# Production values are entered only in GoDaddy's app environment settings (D-016).
# Provider keys (CEOITBox, Resend) are NOT env vars: the Super Admin enters them
# in /superadmin settings, where they are stored encrypted with ENCRYPTION_KEY.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Database (MySQL 8). Values match docker-compose.yml (local port 3307). ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ars_approvals
DB_USER=ars_dev
DB_PASSWORD=ars_dev_password

# --- Firebase Admin (Google sign-in; project power-bi-dashboard-3b29f, D-038) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Secrets: generate fresh values, never reuse the Power BI site's ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Job runner: shared secret cPanel cron sends to /api/jobs/run ---
JOB_RUNNER_SECRET=

# --- Origin lock (D-102, optional): the value a Cloudflare Transform Rule adds
# as the x-ars-origin header. When set, requests that didn't come through
# Cloudflare are refused. Set the Cloudflare rule FIRST (DEPLOYMENT Part E2).
ORIGIN_SECRET=

# --- Attachments (D-072): a folder OUTSIDE the web root that survives deploys ---
# Blank = ./storage/uploads (fine locally). On GoDaddy, e.g. /home/<cpanel-user>/ars-approvals-uploads
UPLOAD_DIR=
